{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tinashe-ai",
  "main": "src/index.js",
  "compatibility_date": "2026-11-01",
  "account_id": "f1760b1459ae3a813581d6a7792e2e5c",
  "workers_dev": true,
  "routes": [
    { "pattern": "tinashe.texcite.co.za", "custom_domain": true }
  ],
  "vars": { "MODEL": "claude-sonnet-5-5" },
  "d1_databases": [
    { "binding": "DB", "database_name": "tinashe-ai-visitors", "database_id": "5b63cd07-80fe-47f6-8880-292e53d2e226" }
  ],
  "observability": { "enabled": true }
}
